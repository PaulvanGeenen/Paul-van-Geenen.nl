    "dicom-parser": "^1.8.21",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "hammerjs": "^2.0.8",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
